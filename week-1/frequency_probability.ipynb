     "text": [
      "{0: 0.3333333333333333, 1: 0.5, 2: 0.16666666666666666}\n"
     ]
    }
   ],
   "source": [
    "total = len(data)\n",
    "probs = {k: v/total for k, v in counts.items()}\n",
    "print(probs)"
   ]
