   "source": [
    "data = [0, 1, 1, 2, 0, 1]\n",
    "\n",
    "counts = {}\n",
    "for item in data:\n",
    "    counts[item] = counts.get(item, 0) + 1\n",
    "\n",
    "    print(counts)"
   ]
